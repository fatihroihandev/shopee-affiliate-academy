# Ignore all hidden files and directories (starting with .) by default
.*

# Whitelist essential dotfiles that ARE safe and needed in the repository
!.gitignore
!.env.example
!.github/
!.github/**

# Dependencies
node_modules/

# Production build artifacts
dist/
dist-ssr/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS files
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# Temporary agent / AI tool caches & local keys
brain/
*.pem
*.key
*.cert
credentials*.json
